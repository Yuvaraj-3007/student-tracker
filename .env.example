# ============================================================
# NIGHTWATCH — Intern Tracking Agent
# Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
#
# Two modes:
#   USE_MOCKS=true  → fully offline, no credentials needed
#   USE_MOCKS=false → real GitHub + Claude + SMTP
# ============================================================

# --- Mode toggle ---
USE_MOCKS=true
MOCK_RANDOMIZE=false

# --- Recipients ---
MANAGER_EMAIL=manager@wisright.com
CC_EMAIL=wisright.support@gmail.com
SEND_STUDENT_EMAILS=false

# --- GitHub API (only required when USE_MOCKS=false) ---
# Fine-grained PAT with Contents: Read-only + Metadata: Read-only
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxx

# --- Claude API (only required when USE_MOCKS=false) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# --- SMTP (only required when USE_MOCKS=false) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=wisright.support@gmail.com
SMTP_PASS=your_gmail_app_password_16_chars
SMTP_FROM=wisright.support@gmail.com
SMTP_FROM_NAME=NIGHTWATCH Agent
